# Fine-grained personal access token, read-only, scoped to the organization(s) you report on.
# Repository permissions: Metadata (read). Organization permissions: Members (read).
GITHUB_TOKEN=

# Optional: comma-separated organizations this deployment will report on (empty = any the token can see).
REPORT_ALLOWED_ORGS=

# Optional: require this value in the X-API-Key header for /api/**.
REPORT_API_KEY=
